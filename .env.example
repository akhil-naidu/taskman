# Convex deployment name from `npx convex dev` (for example, dev:happy-animal-123).
CONVEX_DEPLOYMENT=

# Convex cloud URL. Server-side clients use this.
CONVEX_URL=

# Same cloud URL, exposed to the browser. Required for the live fleet and board.
NEXT_PUBLIC_CONVEX_URL=

# Deploy key for a Convex deployment. The app does not read this at runtime.
CONVEX_DEPLOY_KEY=

# Convex Auth keys. Set these on the Convex deployment. Leave them empty here.
JWT_PRIVATE_KEY=
JWKS=

# Site the browser is served from. Convex Auth uses it for OAuth redirects back to the app.
SITE_URL=

# 32-byte key, base64. Set on the Convex deployment. Encrypts workspace integration secrets.
TASKMAN_ENCRYPTION_KEY=

# Optional platform OAuth client credentials for the TaskMan app. Not customer tokens.
# Leave unset and paste a token in workspace settings instead.
TASKMAN_OAUTH_CLICKUP_CLIENT_ID=
TASKMAN_OAUTH_CLICKUP_CLIENT_SECRET=
TASKMAN_OAUTH_LINEAR_CLIENT_ID=
TASKMAN_OAUTH_LINEAR_CLIENT_SECRET=
TASKMAN_OAUTH_GITHUB_CLIENT_ID=
TASKMAN_OAUTH_GITHUB_CLIENT_SECRET=
TASKMAN_OAUTH_DROPBOX_CLIENT_ID=
TASKMAN_OAUTH_DROPBOX_CLIENT_SECRET=

# Full URL of the Convex HTTP action, for example https://<deployment>.convex.site/ingest.
TASKMAN_INGEST_URL=
