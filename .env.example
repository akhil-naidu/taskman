# Convex deployment name from `npx convex dev` (for example, dev:happy-animal-123).
CONVEX_DEPLOYMENT=

# Convex cloud URL. Server-side clients use this.
CONVEX_URL=

# Same cloud URL, exposed to the browser. Required for the live fleet and board.
NEXT_PUBLIC_CONVEX_URL=

# Deploy key for a Convex deployment. The app does not read this at runtime.
CONVEX_DEPLOY_KEY=

# Shared secret for POST /ingest. Send it as `x-taskman-token` or `Authorization: Bearer`.
TASKMAN_INGEST_TOKEN=

# Full URL of the Convex HTTP action, for example https://<deployment>.convex.site/ingest.
TASKMAN_INGEST_URL=

# Read-only ClickUp personal token. The adapter sends GET requests only.
CLICKUP_API_TOKEN=

# ClickUp workspace id, used when CLICKUP_LIST_IDS is empty.
CLICKUP_TEAM_ID=

# Comma-separated ClickUp list ids. When set, these are fetched instead of the team.
CLICKUP_LIST_IDS=

# Reserved for the GitHub Issues stub. Unused.
GITHUB_TOKEN=

# Reserved for the Linear stub. Unused.
LINEAR_API_KEY=

# Reserved for the Jira stub. Unused.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
